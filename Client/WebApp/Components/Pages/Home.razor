@page "/"
@using DTO.Subforum
@using WebApp.Services.Interfaces
@inject ISubforumService SubforumService

<PageTitle>Discover | yap.</PageTitle>

<div class="home">
    <section class="welcome">
        <div class="welcome-copy">
            <span class="eyebrow">✳ HELLO, STRANGER</span>

            <h1>Find your <em>people.</em></h1>

            <p>
                A cozy corner of the internet for curious minds,
                random thoughts, and really good conversations.
            </p>
        </div>

        <div class="welcome-sticker" aria-hidden="true">
            <span>good</span>
            <span>things</span>
            <span>happen</span>
            <span>here ✳</span>
        </div>
    </section>

    <section class="communities">
        <div class="section-heading">
            <div>
                <span class="eyebrow">A PLACE FOR EVERY INTEREST</span>
                <h2>Explore communities<span class="heading-dot">.</span></h2>
            </div>

            @if (subforums is not null)
            {
                <span class="community-count">
                    @subforums.Count communities
                </span>
            }
        </div>

        @if (errorMessage is not null)
        {
            <div class="feedback">
                <h3>Couldn't load communities.</h3>
                <p>@errorMessage</p>
                <button @onclick="LoadSubforumsAsync">Try again</button>
            </div>
        }
        else if (subforums is null)
        {
            <p class="loading">Finding your communities...</p>
        }
        else if (subforums.Count == 0)
        {
            <div class="feedback">
                <h3>It's a little quiet here.</h3>
                <p>No communities have been created yet.</p>
            </div>
        }
        else
        {
            <div class="community-grid">
                @for (var i = 0; i < subforums.Count; i++)
                {
                    var subforum = subforums[i];
                    var colorIndex = i % 6;

                    <article class="community-card color-@colorIndex">
                        <div class="card-top">
                            <span class="community-icon">✳</span>
                        </div>

                        <div class="card-body">
                            <h3>@subforum.Name</h3>
                            <p>@subforum.Description</p>
                        </div>

                        <div class="card-bottom">
                            <span>@subforum.PostCount posts</span>

                            <a href="@($"/posts?subforumId={subforum.Id}")"
                               aria-label="@($"Browse posts in {subforum.Name}")">
                                Explore <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <footer class="home-footer">
        <span>✳ a little community goes a long way.</span>
        <span>yap. © @DateTime.Now.Year</span>
    </footer>
</div>

@code {
    private List<SubforumDto>? subforums;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubforumsAsync();
    }

    private async Task LoadSubforumsAsync()
    {
        errorMessage = null;
        subforums = null;

        try
        {
            subforums = await SubforumService.GetSubforumsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Please check that the Web API is running.";
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred.";
        }
    }
}