
@page "/"
@using DTO.Posts
@using DTO.Subforum
@using WebApp.Services.Interfaces
@using WebApp.Components.Community
@using WebApp.Components.Post

@inject ISubforumService SubforumService
@inject IPostService PostService

<PageTitle>Discover | yap.</PageTitle>

<div class="home">

    <!-- Welcome -->

    <section class="welcome">
        <div class="welcome-copy">
            <span class="eyebrow">✳ HELLO, STRANGER</span>

            <h1>Find your <em>people.</em></h1>

            <p>
                A cozy corner of the internet for curious minds,
                random thoughts, and really good conversations.
            </p>
        </div>

        <div class="welcome-sticker" aria-hidden="true">
            <span>good</span>
            <span>things</span>
            <span>happen</span>
            <span>here ✳</span>
        </div>
    </section>

    <!-- Latest conversations -->

    <section class="latest-posts">
        <div class="section-heading">
            <div>
                <span class="eyebrow">FRESH OFF THE PRESS</span>
                <h2>
                    Latest conversations<span class="heading-dot">.</span>
                </h2>
            </div>

            @if (latestPosts is not null && latestPosts.Count > 0)
            {
                <span class="community-count">
                    @latestPosts.Count recent
                    @(latestPosts.Count == 1 ? "post" : "posts")
                </span>
            }
        </div>

        @if (postsError is not null)
        {
            <div class="feedback">
                <h3>Couldn't load conversations.</h3>
                <p>@postsError</p>

                <button type="button" @onclick="LoadPostsAsync">
                    Try again
                </button>
            </div>
        }
        else if (latestPosts is null)
        {
            <p class="loading">Finding the latest conversations...</p>
        }
        else if (latestPosts.Count == 0)
        {
            <div class="feedback">
                <h3>Nothing here just yet.</h3>
                <p>
                    The first conversations are still waiting to happen.
                    Why not start one?
                </p>
            </div>
        }
        else
        {
            <div class="latest-posts-list">
                @foreach (var post in latestPosts)
                {
                    <PostCard
                        @key="post.Id"
                        Post="post"
                        AccentColor="@GetPostAccent(post.SubforumId)" />
                }
            </div>
        }
    </section>

    <!-- Communities -->

    <section id="communities" class="communities">
        <div class="section-heading">
            <div>
                <span class="eyebrow">A PLACE FOR EVERY INTEREST</span>
                <h2>
                    Explore communities<span class="heading-dot">.</span>
                </h2>
            </div>

            <div class="heading-actions">
                @if (subforums is not null)
                {
                    <span class="community-count">
                        @subforums.Count
                        @(subforums.Count == 1 ? "community" : "communities")
                    </span>
                }

                <a href="/communities/create" class="create-button">
                    + Create community
                </a>
            </div>
        </div>

        @if (communitiesError is not null)
        {
            <div class="feedback">
                <h3>Couldn't load communities.</h3>
                <p>@communitiesError</p>

                <button type="button" @onclick="LoadSubforumsAsync">
                    Try again
                </button>
            </div>
        }
        else if (subforums is null)
        {
            <p class="loading">Finding your communities...</p>
        }
        else if (subforums.Count == 0)
        {
            <div class="feedback">
                <h3>It's a little quiet here.</h3>
                <p>No communities have been created yet.</p>
            </div>
        }
        else
        {
            <div class="community-grid">
                @foreach (var subforum in subforums)
                {
                    <CommunityCard
                        @key="subforum.Id"
                        Community="subforum" />
                }
            </div>
        }
    </section>

    <!-- Footer -->

    <footer class="home-footer">
        <span>✳ a little community goes a long way.</span>
        <span>yap. © @DateTime.Now.Year</span>
    </footer>
</div>

@code {
    private const int LatestPostCount = 6;

    private List<PostDto>? latestPosts;
    private List<SubforumDto>? subforums;

    private string? postsError;
    private string? communitiesError;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadPostsAsync(),
            LoadSubforumsAsync()
        );
    }

    private async Task LoadPostsAsync()
    {
        postsError = null;
        latestPosts = null;

        try
        {
            var posts = await PostService.GetPostsAsync();

            latestPosts = posts
                .OrderByDescending(p => p.CreatedAt)
                .Take(LatestPostCount)
                .ToList();
        }
        catch (HttpRequestException)
        {
            postsError = "Please check that the Web API is running.";
        }
        catch (Exception)
        {
            postsError = "An unexpected error occurred.";
        }
    }

    private async Task LoadSubforumsAsync()
    {
        communitiesError = null;
        subforums = null;

        try
        {
            subforums = await SubforumService.GetSubforumsAsync();
        }
        catch (HttpRequestException)
        {
            communitiesError = "Please check that the Web API is running.";
        }
        catch (Exception)
        {
            communitiesError = "An unexpected error occurred.";
        }
    }

    private string GetPostAccent(int subforumId)
    {
        return subforums?
            .FirstOrDefault(s => s.Id == subforumId)?
            .Color ?? "var(--coral)";
    }
}
