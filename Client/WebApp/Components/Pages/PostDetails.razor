@page "/posts/{Id:int}"
@using DTO.Posts
@using DTO.PostVote
@using Entities
@using WebApp.Components.Voting
@using WebApp.Components.Comments
@using WebApp.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Post | yap.</PageTitle>

<div class="post-details-page">
    @if (isLoading)
    {
        <p class="status-message">Loading conversation...</p>
    }
    else if (errorMessage is not null)
    {
        <p class="status-message">@errorMessage</p>
    }
    else if (post is not null)
    {
        <article class="post-details">
            <div class="post-meta">
                <a class="community-link"
                   href="@($"/communities/{post.SubforumId}")">
                    y/@post.SubforumName
                </a>

                <a class="author-link"
                   href="@($"/users/{post.UserId}")">
                    u/@post.Username
                </a>
            </div>

            <h1>@post.Title</h1>

            <div class="post-body">@post.Body</div>

            <div class="post-actions">
                @if (votes is not null)
                {
                    <VotePill
                        Likes="@votes.Likes"
                        Dislikes="@votes.Dislikes"
                        UserVote="@votes.UserVote"
                        Compact="true"
                        Disabled="@isVoting"
                        OnUpvote="() => VoteAsync(VoteType.Like)"
                        OnDownvote="() => VoteAsync(VoteType.Dislike)"/>
                }

                <div class="comment-pill">
                    <LucideIcon Name="message-circle" Size="18"/>
                    <span>@(post.Comments?.Count ?? 0)</span>
                </div>
            </div>
        </article>

        <section class="comments-section">
            <div class="comments-heading">
                <h2>Comments</h2>
                <span>@(post.Comments?.Count ?? 0)</span>
            </div>


            <CommentForm
                PostId="@Id"
                OnCommentAdded="RefreshCommentsAsync" />

            @if (post.Comments is null || post.Comments.Count == 0)
            {
                <div class="empty-comments">
                    <LucideIcon Name="message-circle" Size="24"/>
                    <p>No comments yet.</p>
                    <span>Be the first to join the conversation.</span>
                </div>
            }
            else
            {
                <div class="comments-list">
                    @foreach (var comment in post.Comments
                                      .Where(c => c.ParentCommentId is null)
                                      .OrderByDescending(c => c.CreatedAt))
                    {
                        <CommentThread
                            @key="comment.Id"
                            Comment="@comment"
                            AllComments="@post.Comments"
                            OnCommentAdded="RefreshCommentsAsync"/>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private PostDetailsDto? post;
    private PostVoteSummaryDto? votes;

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        post = null;
        votes = null;

        try
        {
            var postTask = PostService.GetPostAsync(Id, includeComments: true);
            var votesTask = PostService.GetVotesAsync(Id);

            await Task.WhenAll(postTask, votesTask);

            post = await postTask;
            votes = await votesTask;
        }
        catch (HttpRequestException)
        {
            errorMessage = "We couldn't load this conversation. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshCommentsAsync()
    {
        post = await PostService.GetPostAsync(
            Id,
            includeComments: true
        );
    }

    private bool isVoting;

    private async Task VoteAsync(VoteType voteType)
    {
        if (isVoting)
            return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isVoting = true;

        try
        {
            var dto = new CreatePostVoteDto(voteType);

            await PostService.AddVoteAsync(Id, dto);

            votes = await PostService.GetVotesAsync(Id);
        }
        finally
        {
            isVoting = false;
        }
    }

}