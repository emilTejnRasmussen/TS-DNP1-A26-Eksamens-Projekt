
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using WebApp.Services.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="nav-container">

    <AuthorizeView>
        <Authorized Context="auth">
            <div class="user-welcome">
                <div class="welcome-heading">
                    <span>Hello,</span>
                    <strong title="@auth.User.Identity?.Name">
                        @auth.User.Identity?.Name!
                    </strong>
                </div>

                <NavLink class="profile-link"
                         href="@($"/users/{auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value}")"
                         title="@($"u/{auth.User.Identity?.Name}")">
                    u/@auth.User.Identity?.Name
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="sidebar-section">
        <span class="section-label">YOUR SPACE</span>

        <nav class="navigation">
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="nav-symbol">⌂</span>
                Discover
            </NavLink>

            <a href="/#communities">
                <span class="nav-symbol">#</span>
                Communities
            </a>

            <AuthorizeView>
                <Authorized>
                    <NavLink href="/communities/create">
                        <span class="nav-symbol">+</span>
                        Create community
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
    </div>

    <div class="account-footer">
        <AuthorizeView>
            <Authorized>
                <button type="button"
                        class="footer-action"
                        @onclick="Logout">
                    <LucideIcon Name="log-out" Size="17" />
                    <span>Log out</span>
                </button>
            </Authorized>

            <NotAuthorized>
                <NavLink href="/login" class="footer-action">
                    <LucideIcon Name="log-in" Size="17" />
                    <span>Log in</span>
                </NavLink>

                <NavLink href="/register" class="footer-action">
                    <LucideIcon Name="user-plus" Size="17" />
                    <span>Join yap.</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>

</div>

@code {
    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }
}
